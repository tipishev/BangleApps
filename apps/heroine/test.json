{
  "app": "heroine",
  "tests": [
    {
      "description": "Attack and win",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.state",
          "is": "equal",
          "to": "4",
          "text": "the app starts on the title"
        },
        {
          "t": "cmd",
          "js": "ctx.state=0;ctx.options.minimap=true;render()",
          "text": "skip the title like Continue (which redraws), minimap on (tested separately)"
        },
        {
          "t": "cmd",
          "js": "global.setInterval=function(){return 1;};global.clearInterval=function(){};global.RQ=[];Math.random=function(){return RQ.length?RQ.shift():0.5;};ctx.explore.encounter_increment=0",
          "text": "ticks by hand, Math.random from the queue RQ (0.5 when empty), no random encounters"
        },
        {
          "t": "cmd",
          "js": "require(\"heroine_combat\").start(ctx,0,\"\")"
        },
        {
          "t": "cmd",
          "js": "handle_input({tick: 100})",
          "text": "let the animation run to its end"
        },
        {
          "t": "assert",
          "js": "ctx.combat.enemy.hp",
          "is": "equal",
          "to": "6",
          "text": "Shadow Tendrils"
        },
        {
          "t": "cmd",
          "js": "RQ=[0.5,1,0.5]"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "swipe up attacks: hit, max damage (Bare Fists 1-4), no crit"
        },
        {
          "t": "assert",
          "js": "ctx.combat.phase",
          "is": "equal",
          "to": "require(\"heroine_combat\").PHASE_OFFENSE"
        },
        {
          "t": "assert",
          "js": "ctx.combat.offense_result",
          "is": "equal",
          "to": "\"4 damage\""
        },
        {
          "t": "assert",
          "js": "ctx.combat.enemy.hp",
          "is": "equal",
          "to": "2"
        },
        {
          "t": "cmd",
          "js": "RQ=[1,0];handle_input({tick: 3})",
          "text": "3 frames into the attack"
        },
        {
          "t": "assert",
          "js": "ctx.combat.enemy_offset.x == 2 && ctx.combat.enemy_offset.y == -2",
          "is": "true",
          "text": "the hit enemy shakes"
        },
        {
          "t": "cmd",
          "js": "handle_input({tick: 12})",
          "text": "15 frames in"
        },
        {
          "t": "assert",
          "js": "ctx.combat.enemy_offset.x == 0 && ctx.combat.enemy_offset.y == 0",
          "is": "true",
          "text": "shaking stops"
        },
        {
          "t": "cmd",
          "js": "handle_input({tick: 100})",
          "text": "let the animation run to its end"
        },
        {
          "t": "assert",
          "js": "ctx.combat.phase",
          "is": "equal",
          "to": "require(\"heroine_combat\").PHASE_DEFENSE",
          "text": "the enemy strikes back"
        },
        {
          "t": "assert",
          "js": "ctx.combat.defense_action",
          "is": "equal",
          "to": "\"Attack!\""
        },
        {
          "t": "assert",
          "js": "ctx.combat.defense_result",
          "is": "equal",
          "to": "\"2 damage\"",
          "text": "4 damage (2-5) minus 2 for Serf Rags"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.hp",
          "is": "equal",
          "to": "23"
        },
        {
          "t": "cmd",
          "js": "handle_input({tick: 100})",
          "text": "let the animation run to its end"
        },
        {
          "t": "assert",
          "js": "ctx.combat.phase",
          "is": "equal",
          "to": "require(\"heroine_combat\").PHASE_INPUT"
        },
        {
          "t": "cmd",
          "js": "RQ=[0.5,1,0.5]"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "cmd",
          "js": "handle_input({tick: 100})",
          "text": "let the animation run to its end"
        },
        {
          "t": "assert",
          "js": "ctx.combat.phase",
          "is": "equal",
          "to": "require(\"heroine_combat\").PHASE_VICTORY"
        },
        {
          "t": "assert",
          "js": "ctx.combat.reward_result",
          "is": "equal",
          "to": "\"+2 Gold!\""
        },
        {
          "t": "assert",
          "js": "ctx.avatar.gold",
          "is": "equal",
          "to": "2"
        },
        {
          "t": "assert",
          "js": "require(\"Storage\").readJSON(\"heroine.save.json\",true).gold",
          "is": "equal",
          "to": "2",
          "text": "victory saves"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.campaign.length",
          "is": "equal",
          "to": "0",
          "text": "no campaign flag for a random enemy"
        },
        {
          "t": "emit",
          "event": "touch",
          "paramsArray": [
            1,
            {
              "x": 88,
              "y": 88
            }
          ],
          "text": "continue"
        },
        {
          "t": "assert",
          "js": "ctx.state",
          "is": "equal",
          "to": "0"
        },
        {
          "t": "assert",
          "js": "!ctx.animating",
          "is": "true"
        }
      ]
    },
    {
      "description": "Walk from the start to the end of the demo at Stonegate",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "cmd",
          "js": "ctx.explore.encounter_increment=0",
          "text": "no random encounters in this test"
        },
        {
          "t": "cmd",
          "js": "\"TT\".split(\"\").forEach(function(i){handle_input({F:{up:true},D:{down:true},L:{left:true},R:{right:true},T:{tap:{x:88,y:88}},B:{btn:true}}[i]);})",
          "text": "Start, Wake up"
        },
        {
          "t": "assert",
          "js": "ctx.state",
          "is": "equal",
          "to": "0"
        },
        {
          "t": "cmd",
          "js": "\"FRFRFFLFFRFFFFFFF\".split(\"\").forEach(function(i){handle_input({F:{up:true},D:{down:true},L:{left:true},R:{right:true},T:{tap:{x:88,y:88}},B:{btn:true}}[i]);})",
          "text": "to the Meditation Point chest: 13 steps"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.spellbook",
          "is": "equal",
          "to": "1",
          "text": "found the Heal spellbook"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.gold+=100",
          "text": "gold for Burn, standing in for fights"
        },
        {
          "t": "cmd",
          "js": "\"RRFFFFFFFFFFFFFFFLFRFFLFRFLFRFFFFLFRFFFFFFFFFRFLFFRF\".split(\"\").forEach(function(i){handle_input({F:{up:true},D:{down:true},L:{left:true},R:{right:true},T:{tap:{x:88,y:88}},B:{btn:true}}[i]);})",
          "text": "into Sage Therel's: 39 steps"
        },
        {
          "t": "assert",
          "js": "ctx.dialog.title",
          "is": "equal",
          "to": "\"Sage Therel\""
        },
        {
          "t": "cmd",
          "js": "\"FTB\".split(\"\").forEach(function(i){handle_input({F:{up:true},D:{down:true},L:{left:true},R:{right:true},T:{tap:{x:88,y:88}},B:{btn:true}}[i]);})",
          "text": "select the spellbook, buy it, leave"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.spellbook",
          "is": "equal",
          "to": "2",
          "text": "learned Burn"
        },
        {
          "t": "cmd",
          "js": "\"RFFRFFFLFRFFRFLFFRFFFFFLFFFRFFFLFRFFFFFFFFFFF\".split(\"\").forEach(function(i){handle_input({F:{up:true},D:{down:true},L:{left:true},R:{right:true},T:{tap:{x:88,y:88}},B:{btn:true}}[i]);})",
          "text": "to the bone pile in the Trade Tunnel: 34 steps"
        },
        {
          "t": "cmd",
          "js": "\"TRTB\".split(\"\").forEach(function(i){handle_input({F:{up:true},D:{down:true},L:{left:true},R:{right:true},T:{tap:{x:88,y:88}},B:{btn:true}}[i]);})",
          "text": "face it, Info, select Burn, cast, close"
        },
        {
          "t": "assert",
          "js": "ctx.info.power_result",
          "is": "equal",
          "to": "\"Cleared Path!\""
        },
        {
          "t": "cmd",
          "js": "\"FFFFFFFFFFFF\".split(\"\").forEach(function(i){handle_input({F:{up:true},D:{down:true},L:{left:true},R:{right:true},T:{tap:{x:88,y:88}},B:{btn:true}}[i]);})",
          "text": "to Stonegate: 12 steps"
        },
        {
          "t": "assert",
          "js": "ctx.state",
          "is": "equal",
          "to": "3"
        },
        {
          "t": "assert",
          "js": "ctx.dialog.title",
          "is": "equal",
          "to": "\"Stonegate Entrance\""
        },
        {
          "t": "assert",
          "js": "ctx.dialog.option[1].msg2",
          "is": "equal",
          "to": "\"Thanks for playing!)\""
        }
      ]
    },
    {
      "description": "Font pixel parity with the original",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "cmd",
          "js": "global.fontcrc=function(t,x,y,j,c){var OX=8,OY=32,B=g.toColor(\"#00F\"),K=g.toColor(\"#000\"),W=g.toColor(\"#FFF\"),R=g.toColor(\"#F00\");g.setColor(B).fillRect(OX,OY,OX+159,OY+119);var f=require(\"heroine_bitfont\");f.set_color(c);f.render(t,x,y,j);var s=\"\";for(var yy=y;yy<y+8;yy++)for(var xx=0;xx<160;xx++){var p=g.getPixel(OX+xx,OY+yy);s+=p==B?\".\":p==K?\"#\":p==W?\"o\":p==R?\"r\":\"?\";}return E.CRC32(s);}",
          "text": "define fontcrc(), see scripts/font_reference.py"
        },
        {
          "t": "assert",
          "js": "fontcrc(\"!\\\"#$%&'()*+,-./\",2,2,0,0)",
          "is": "equal",
          "to": "549737886",
          "text": "\"!\\\"#$%&'()*+,-./\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"0123456789:;<=>?@\",2,12,0,0)",
          "is": "equal",
          "to": "784644739",
          "text": "\"0123456789:;<=>?@\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"ABCDEFGHIJKLM\",2,22,0,0)",
          "is": "equal",
          "to": "2380124298",
          "text": "\"ABCDEFGHIJKLM\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"NOPQRSTUVWXYZ\",2,32,0,0)",
          "is": "equal",
          "to": "1339923442",
          "text": "\"NOPQRSTUVWXYZ\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"[\\\\]^_`{|}~\",2,42,0,0)",
          "is": "equal",
          "to": "4218809469",
          "text": "\"[\\\\]^_`{|}~\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"west\",60,34,0,0)",
          "is": "equal",
          "to": "2532185294",
          "text": "\"west\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"0 Gold\",158,110,1,0)",
          "is": "equal",
          "to": "3432912705",
          "text": "\"0 Gold\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"INFO\",80,2,2,0)",
          "is": "equal",
          "to": "4032207004",
          "text": "\"INFO\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"Gar'ashi Monastery\",80,60,2,0)",
          "is": "equal",
          "to": "4045119380",
          "text": "\"Gar'ashi Monastery\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"Victory!\",80,60,2,0)",
          "is": "equal",
          "to": "547635168",
          "text": "\"Victory!\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"You rest for awhile.\",2,100,0,0)",
          "is": "equal",
          "to": "111591779",
          "text": "\"You rest for awhile.\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"  two  spaces \",158,50,1,0)",
          "is": "equal",
          "to": "899601055",
          "text": "\"  two  spaces \""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"HP 5/25\",2,100,0,1)",
          "is": "equal",
          "to": "2400638639",
          "text": "\"HP 5/25\""
        },
        {
          "t": "assert",
          "js": "fontcrc(\"You are defeated...\",158,100,1,1)",
          "is": "equal",
          "to": "3467496429",
          "text": "\"You are defeated...\""
        }
      ]
    }
  ]
}
