{
  "app": "heroine",
  "tests": [
    {
      "description": "Walk from Serf Quarters to the Monastery",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "0"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 1 && ctx.avatar.y == 1",
          "is": "true"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "step forward (south)"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.y",
          "is": "equal",
          "to": "2"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "blocked by a wall"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.y",
          "is": "equal",
          "to": "2"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            1
          ],
          "text": "diagonal swipes are ignored"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.facing",
          "is": "equal",
          "to": "'south'"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ],
          "text": "turn right"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.facing",
          "is": "equal",
          "to": "'west'"
        },
        {
          "t": "emit",
          "event": "touch",
          "paramsArray": [
            1,
            {
              "x": 88,
              "y": 88
            }
          ],
          "text": "taps do nothing while exploring yet"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "walk through the door"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 6 && ctx.avatar.y == 6",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.map_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"Gar'ashi Monastery\""
        },
        {
          "t": "assert",
          "js": "ctx.minimap.map_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "assert",
          "js": "ctx.minimap.layers.walkable.width",
          "is": "equal",
          "to": "27"
        },
        {
          "t": "assert",
          "js": "ctx.atlas.maps[0].tiles[1][1]",
          "is": "equal",
          "to": "17",
          "text": "atlas is not altered by the map copy"
        }
      ]
    },
    {
      "description": "No memory leak when switching maps",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "saveMemoryUsage"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ],
          "text": "arrived at 6,6 facing west, turn north"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ],
          "text": "turn east"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "back through the door to Serf Quarters"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "0"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "and back to the Monastery"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "checkMemoryUsage"
        }
      ]
    },
    {
      "description": "Monastery to Cedar Village and back",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.x=4;ctx.avatar.y=9;require(\"heroine_mazemap\").set(ctx,1);ctx.avatar.facing=\"south\"",
          "text": "stand next to an exit on map 1"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "Monastery south door"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "4"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 6 && ctx.avatar.y == 2",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"Monastery Trail\""
        },
        {
          "t": "assert",
          "js": "ctx.minimap.map_id",
          "is": "equal",
          "to": "4"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.x=10;ctx.avatar.y=14;require(\"heroine_mazemap\").set(ctx,4);ctx.avatar.facing=\"south\"",
          "text": "stand next to an exit on map 4"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "Monastery Trail south exit"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "5"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 3 && ctx.avatar.y == 1",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"Cedar Village\""
        },
        {
          "t": "assert",
          "js": "ctx.minimap.map_id",
          "is": "equal",
          "to": "5"
        },
        {
          "t": "assert",
          "js": "ctx.minimap.layers.doors.width",
          "is": "equal",
          "to": "ctx.mazemap.width*3",
          "text": "minimap covers the whole map, incl. shop doors"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.facing=\"north\""
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "Cedar Village north exit"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "4"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 10 && ctx.avatar.y == 14",
          "is": "true"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.x=6;ctx.avatar.y=2;require(\"heroine_mazemap\").set(ctx,4);ctx.avatar.facing=\"north\"",
          "text": "stand next to an exit on map 4"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "Monastery Trail north exit"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 4 && ctx.avatar.y == 9",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.minimap.map_id",
          "is": "equal",
          "to": "1"
        }
      ]
    },
    {
      "description": "Fixed helpers: set_tile, respawn, enemy_render, old cache clean-up",
      "steps": [
        {
          "t": "jsonfile",
          "name": "heroine_minimap_cache_1",
          "json": {
            "old": "cache"
          },
          "text": "file left by the old minimap cache"
        },
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "require(\"Storage\").list(/^heroine_minimap_cache_/).length",
          "is": "equal",
          "to": "0",
          "text": "old cache files are erased at startup"
        },
        {
          "t": "cmd",
          "js": "require(\"heroine_mazemap\").set_tile(ctx.mazemap,1,1,5)"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[1][1]",
          "is": "equal",
          "to": "5"
        },
        {
          "t": "assert",
          "js": "ctx.atlas.maps[0].tiles[1][1]",
          "is": "equal",
          "to": "17",
          "text": "set_tile doesn't alter the atlas"
        },
        {
          "t": "cmd",
          "js": "require(\"heroine_mazemap\").set_tile(ctx.mazemap,99,99,5)",
          "text": "out of bounds is ignored"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.sleeploc=[5,3,1];ctx.avatar.gold=7;ctx.avatar.hp=1;require(\"heroine_avatar\").respawn(ctx)"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "5"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 3 && ctx.avatar.y == 1",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.gold == 0 && ctx.avatar.hp == ctx.avatar.max_hp",
          "is": "true"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            -1,
            0
          ],
          "text": "turn, which redraws"
        },
        {
          "t": "assert",
          "js": "ctx.minimap.map_id",
          "is": "equal",
          "to": "5",
          "text": "minimap follows a respawn without an explicit call"
        },
        {
          "t": "assert",
          "js": "[0,1,2,3,4,5,6,7].every(function(id){require(\"heroine_enemy\").enemy_render(id);return true;})",
          "is": "true",
          "text": "every enemy image draws"
        }
      ]
    },
    {
      "description": "Save on map change and when the app closes",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "require(\"Storage\").read(\"heroine.save.json\")",
          "is": "equal",
          "to": "undefined",
          "text": "a new game has no save yet"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "into the Monastery"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "assert",
          "js": "require(\"Storage\").readJSON(\"heroine.save.json\",true).map_id == 1 && require(\"Storage\").readJSON(\"heroine.save.json\",true).x == 6 && require(\"Storage\").readJSON(\"heroine.save.json\",true).y == 6",
          "is": "true",
          "text": "saved on map change"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "step west"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            -1,
            0
          ],
          "text": "turn south"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 5 && ctx.avatar.facing == \"south\"",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "require(\"Storage\").readJSON(\"heroine.save.json\",true).x",
          "is": "equal",
          "to": "6",
          "text": "steps and turns are not saved right away"
        },
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "1",
          "text": "closing the app saved the game"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 5 && ctx.avatar.y == 6 && ctx.avatar.facing == \"south\"",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.minimap.map_id",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.moved",
          "is": "equal",
          "to": "false"
        }
      ]
    },
    {
      "description": "Loading a save of a dead heroine, from an older version",
      "steps": [
        {
          "t": "cmd",
          "js": "0",
          "text": "she died standing on the Monastery Trail emerald chest (2,2): loading must not open it"
        },
        {
          "t": "jsonfile",
          "name": "heroine.save.json",
          "json": {
            "x": 2,
            "y": 2,
            "facing": "east",
            "map_id": 4,
            "hp": 0,
            "max_hp": 30,
            "gold": 50,
            "sleeploc": [
              5,
              3,
              1
            ]
          },
          "text": "died on Monastery Trail"
        },
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "5",
          "text": "respawned at the sleep point"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.x == 3 && ctx.avatar.y == 1",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.hp == 30 && ctx.avatar.gold == 0",
          "is": "true",
          "text": "healed, lost all gold"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.max_mp",
          "is": "equal",
          "to": "4",
          "text": "missing fields get their starting values"
        },
        {
          "t": "assert",
          "js": "Array.isArray(ctx.avatar.campaign)",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.campaign.length",
          "is": "equal",
          "to": "0",
          "text": "the chest on the map she died on stays closed"
        }
      ]
    },
    {
      "description": "A broken save starts a new game",
      "steps": [
        {
          "t": "cmd",
          "js": "require(\"Storage\").write(\"heroine.save.json\",\"{broken\")",
          "text": "corrupted save, app not running yet"
        },
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id == 0 && ctx.avatar.x == 1 && ctx.avatar.y == 1 && ctx.avatar.hp == 25",
          "is": "true"
        }
      ]
    },
    {
      "description": "Item tables",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "require(\"heroine_items\").weapons.length == 8 && require(\"heroine_items\").armors.length == 8 && require(\"heroine_items\").spells.length == 7",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "require(\"heroine_items\").weapons[ctx.avatar.weapon].name",
          "is": "equal",
          "to": "\"Bare Fists\""
        },
        {
          "t": "assert",
          "js": "require(\"heroine_items\").armors[ctx.avatar.armor].name",
          "is": "equal",
          "to": "\"Serf Rags\""
        },
        {
          "t": "assert",
          "js": "require(\"heroine_items\").weapons[7].atk_max",
          "is": "equal",
          "to": "18"
        }
      ]
    },
    {
      "description": "Rest on the hay bale, open the Monk Quarters chest, restart",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"\"",
          "text": "starting on the hay bale doesn't rest"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.hp=3;ctx.avatar.mp=1",
          "text": "hurt"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "step off the hay bale"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            1
          ],
          "text": "and back on it"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"You rest for awhile.\""
        },
        {
          "t": "assert",
          "js": "ctx.avatar.hp == 25 && ctx.avatar.mp == 4",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "JSON.stringify(ctx.avatar.sleeploc)",
          "is": "equal",
          "to": "\"[0,1,1]\""
        },
        {
          "t": "assert",
          "js": "require(\"Storage\").readJSON(\"heroine.save.json\",true).hp",
          "is": "equal",
          "to": "25",
          "text": "resting saves"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "into the Monastery, facing west"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ]
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "west door into Monk Quarters"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "2"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            1,
            0
          ],
          "text": "face north"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[1][1]",
          "is": "equal",
          "to": "8",
          "text": "the chest is there"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "onto the chest"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"Found Wood Stick!\""
        },
        {
          "t": "assert",
          "js": "ctx.avatar.weapon",
          "is": "equal",
          "to": "1"
        },
        {
          "t": "assert",
          "js": "ctx.explore.treasure_id",
          "is": "equal",
          "to": "0",
          "text": "shown once, then cleared by the render"
        },
        {
          "t": "assert",
          "js": "require(\"Storage\").readJSON(\"heroine.save.json\",true).campaign.indexOf(\"stick\") > -1",
          "is": "true",
          "text": "opening a chest saves"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            1
          ],
          "text": "step back"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[1][1]",
          "is": "equal",
          "to": "5",
          "text": "the opened chest is gone"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "onto the empty spot"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"\"",
          "text": "nothing to find twice"
        },
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "2"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[1][1]",
          "is": "equal",
          "to": "5",
          "text": "still gone after a restart"
        },
        {
          "t": "assert",
          "js": "ctx.atlas.maps[2].tiles[1][1]",
          "is": "equal",
          "to": "8",
          "text": "the atlas keeps its chest"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.weapon",
          "is": "equal",
          "to": "1"
        }
      ]
    },
    {
      "description": "Gold chest in Cedar Village",
      "steps": [
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "cmd",
          "js": "ctx.avatar.x=6;ctx.avatar.y=10;require(\"heroine_mazemap\").set(ctx,5);ctx.avatar.facing=\"east\"",
          "text": "next to the chest"
        },
        {
          "t": "emit",
          "event": "swipe",
          "paramsArray": [
            0,
            -1
          ],
          "text": "onto the chest"
        },
        {
          "t": "assert",
          "js": "ctx.explore.message",
          "is": "equal",
          "to": "\"Found 10 Gold\""
        },
        {
          "t": "assert",
          "js": "ctx.avatar.gold",
          "is": "equal",
          "to": "10"
        },
        {
          "t": "assert",
          "js": "ctx.explore.gold_value",
          "is": "equal",
          "to": "0",
          "text": "gold pile shown once"
        }
      ]
    },
    {
      "description": "Burned bones and unlocked doors are restored on load",
      "steps": [
        {
          "t": "jsonfile",
          "name": "heroine.save.json",
          "json": {
            "x": 1,
            "y": 7,
            "facing": "east",
            "map_id": 8,
            "campaign": [
              "bone1",
              "door1",
              "atk1"
            ]
          }
        },
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id",
          "is": "equal",
          "to": "8"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[7][4]",
          "is": "equal",
          "to": "5",
          "text": "bone pile at 4,7 burned"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[2][4]",
          "is": "equal",
          "to": "16",
          "text": "bone pile at 4,2 still there"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[12][4]",
          "is": "equal",
          "to": "3",
          "text": "door at 4,12 unlocked"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[2][3]",
          "is": "equal",
          "to": "5",
          "text": "opened ruby chest hidden on load"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[12][3]",
          "is": "equal",
          "to": "8",
          "text": "unopened chest still there"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.tiles[12][3]",
          "is": "equal",
          "to": "8",
          "text": "unopened chest still there"
        },
        {
          "t": "cmd",
          "js": "require(\"heroine_mapscript\").bone_pile_save(ctx,4,2);require(\"heroine_mapscript\").locked_door_save(ctx,4,99)"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.campaign.indexOf(\"bone2\") > -1 && ctx.avatar.campaign.length == 4",
          "is": "true",
          "text": "only known spots are remembered"
        }
      ]
    },
    {
      "description": "Respawning doesn't open a chest on the respawn map",
      "steps": [
        {
          "t": "jsonfile",
          "name": "heroine.save.json",
          "json": {
            "x": 1,
            "y": 1,
            "facing": "north",
            "map_id": 0,
            "hp": 0,
            "sleeploc": [
              2,
              1,
              2
            ]
          },
          "text": "died at 1,1 (the Monk Quarters chest spot), sleep point in Monk Quarters"
        },
        {
          "t": "load",
          "fn": "heroine.app.js"
        },
        {
          "t": "assert",
          "js": "ctx.mazemap.current_id == 2 && ctx.avatar.x == 1 && ctx.avatar.y == 2",
          "is": "true"
        },
        {
          "t": "assert",
          "js": "ctx.avatar.campaign.length == 0 && ctx.avatar.weapon == 0",
